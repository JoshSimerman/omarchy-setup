 Item {
   id: root
+
+  // User-owned OLED mitigation; offsets only, no shader or screen blanking.
+  readonly property bool oledShiftEnabled: barConfig.oledShiftEnabled !== false
+  readonly property int oledShiftIntervalSeconds: Math.max(10, Math.min(3600,
+    Number(barConfig.oledShiftIntervalSeconds) || 180))
+  property int oledShiftPhase: 0
+  readonly property int oledEdgeOffset: oledShiftEnabled
+    ? [-2, 0, 2, 2, 0, -2][oledShiftPhase] : 0
+  readonly property int oledCenterOffset: oledShiftEnabled
+    ? [-1, 0, 1, 1, 0, -1][oledShiftPhase] : 0
+
+  Timer {
+    interval: root.oledShiftIntervalSeconds * 1000
+    repeat: true
+    running: root.oledShiftEnabled
+    onTriggered: {
+      // Avoid moving a click target or a popup's anchor during interaction.
+      if (!root.barHovered && !root.activePopout && !root.barDragSource)
+        root.oledShiftPhase = (root.oledShiftPhase + 1) % 6
+    }
+  }
 
