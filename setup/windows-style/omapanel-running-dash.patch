+
+            readonly property bool runningDash: chip.ready && !chip.isActive && !chip.isClosedPinned && taskbar.activeIndicator !== "None"
+
+
+            visible: chip.ready && (chip.isActive || runningDash) && taskbar.activeIndicator !== "None"
+
             width: {
                 if (!chip.ready)
                     return 0;
 
+                if (runningDash)
+                    return Style.space(6);
+
                 if (dotIndicator)
                     return Style.space(taskbar.indicatorSize);
 
