             z: 2
-            color: chip.ready ? taskbar.indicatorColor : Color.accent
+            color: runningDash ? "#8a8a8a" : (chip.ready ? taskbar.indicatorColor : Color.accent)
             radius: height / 2
 
             Behavior on width {
